<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Brokey_APP.MainPage"
             BackgroundColor="{StaticResource BrokeyBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="24,30" Spacing="16">
            <Label Text="Brokey"
                   Style="{StaticResource BrokeyLogoText}" />

            <Border StyleClass="SurfaceCard">
                <VerticalStackLayout Spacing="10">
                    <Image Source="brokey_mascot.png"
                           HeightRequest="110"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />
                    <Label Text="Everything is ready."
                           Style="{StaticResource SectionTitle}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Use the app shells to navigate through auth and trip management flows."
                           Style="{StaticResource PageSubtitle}"
                           HorizontalTextAlignment="Center" />
                    <Button x:Name="CounterBtn"
                            Text="Tap for feedback"
                            Clicked="OnCounterClicked"
                            HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
