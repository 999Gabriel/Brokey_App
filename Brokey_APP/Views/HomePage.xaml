<?xml version="1.0" encoding="utf-8" ?>
<views:AnimatedContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Brokey_APP.Views"
             xmlns:vm="clr-namespace:Brokey_APP.ViewModels"
             xmlns:models="clr-namespace:Brokey_APP.Models"
             x:Class="Brokey_APP.Views.HomePage"
             x:Name="HomePageRoot"
             x:DataType="vm:HomeViewModel"
             Title="Home"
             BackgroundColor="{StaticResource BrokeyBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="22,18,22,24" Spacing="14">
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 26"
                    Padding="0"
                    Margin="0,6,0,2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFFF" Offset="0" />
                        <GradientStop Color="#F4EEFF" Offset="0.55" />
                        <GradientStop Color="#FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid HeightRequest="230" Padding="18,18,18,14">
                    <!-- Soft background blobs -->
                    <Border BackgroundColor="{StaticResource Secondary}"
                            Stroke="Transparent"
                            StrokeShape="Ellipse"
                            WidthRequest="240"
                            HeightRequest="240"
                            Opacity="0.95"
                            TranslationX="-130"
                            TranslationY="-90"
                            HorizontalOptions="Start"
                            VerticalOptions="Start" />
                    <Border BackgroundColor="{StaticResource Primary}"
                            Stroke="Transparent"
                            StrokeShape="Ellipse"
                            WidthRequest="210"
                            HeightRequest="210"
                            Opacity="0.06"
                            TranslationX="90"
                            TranslationY="-70"
                            HorizontalOptions="End"
                            VerticalOptions="Start" />

                    <!-- Greeting -->
                    <VerticalStackLayout Spacing="2"
                                         HorizontalOptions="Start"
                                         VerticalOptions="Start">
                        <Label Text="{Binding UserName, StringFormat='Hey, {0}'}"
                               Style="{StaticResource PageTitle}"
                               FontSize="30" />
                        <Label Text="Ready to keep your trip budget clean and clear?"
                               FontFamily="InterItalic"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}" />
                    </VerticalStackLayout>

                    <!-- Big wordmark (bottom-right) -->
                    <Label Text="Brokey"
                           Style="{StaticResource BrokeyWordmarkGhost}"
                           FontSize="60"
                           Opacity="0.14"
                           Margin="0,0,4,0" />

                    <!-- Corner sidekick (overlay, responsive width) -->
                    <Grid HorizontalOptions="End"
                          VerticalOptions="End"
                          Margin="0,0,-10,-10"
                          ZIndex="2">
                        <Image Source="brokey_mascot.png"
                               HeightRequest="150"
                               WidthRequest="150"
                               Aspect="AspectFit"
                               HorizontalOptions="End"
                               VerticalOptions="End"
                               TranslationX="32"
                               TranslationY="10" />

                        <Grid WidthRequest="250"
                              HorizontalOptions="End"
                              VerticalOptions="End"
                              Margin="0,0,112,64">
                            <Border BackgroundColor="{StaticResource White}"
                                    Stroke="{StaticResource BorderSubtle}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="14,12">
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource BlackBrush}" Offset="0,10" Radius="22" Opacity="0.08" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="7">
                                    <Label Text="HOME"
                                           Style="{StaticResource MonoTag}" />
                                    <Label Style="{StaticResource SpeechBubbleText}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Kurzer Plan: Erstelle einen " />
                                                <Span Text="Trip"
                                                      FontFamily="InterBold"
                                                      TextColor="{StaticResource Primary}" />
                                                <Span Text=" oder oeffne einen bestehenden." />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="Ich schau von rechts rein."
                                           FontFamily="InterItalic"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Bubble tail -->
                            <Border BackgroundColor="{StaticResource White}"
                                    Stroke="{StaticResource BorderSubtle}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 3"
                                    WidthRequest="14"
                                    HeightRequest="14"
                                    Rotation="45"
                                    HorizontalOptions="End"
                                    VerticalOptions="End"
                                    TranslationX="-18"
                                    TranslationY="8" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Label Text="Quick actions" Style="{StaticResource SectionTitle}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Grid.Column="0" StyleClass="SurfaceCard">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenCreateTripCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                        <Border StyleClass="TagPill" HorizontalOptions="Start">
                            <Label Text="NEW" Style="{StaticResource MonoTag}" />
                        </Border>
                        <Label Text="Create trip"
                               Style="{StaticResource CardTitle}" />
                        <Label Text="Set destination, dates, and members."
                               Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" StyleClass="SurfaceCard">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenTripsCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                        <Border StyleClass="TagPill" HorizontalOptions="Start">
                            <Label Text="OPEN" Style="{StaticResource MonoTag}" />
                        </Border>
                        <Label Text="My trips"
                               Style="{StaticResource CardTitle}" />
                        <Label Text="Jump back into current plans."
                               Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="Recent activity" Style="{StaticResource SectionTitle}" />

            <VerticalStackLayout Spacing="8">
                <!-- Empty state -->
                <Border StyleClass="SurfaceCard" IsVisible="{Binding HasActivities, Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Border StyleClass="TagPill"
                                HorizontalOptions="Center">
                            <Label Text="EMPTY" Style="{StaticResource MonoTag}" />
                        </Border>
                        <Label Text="No recent activity yet"
                               Style="{StaticResource CardTitle}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Your latest expenses and settlements will show up here."
                               Style="{StaticResource MutedText}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Activities list -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentActivities}"
                                     IsVisible="{Binding HasActivities}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ExpenseResponse">
                            <Border StyleClass="SurfaceCard">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.OpenExpenseDetailCommand, Source={x:Reference HomePageRoot}}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                    <Border BackgroundColor="{StaticResource Secondary}"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="10"
                                            WidthRequest="44"
                                            HeightRequest="44"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding CategoryName}"
                                               FontSize="10"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" FontSize="15" />
                                        <Label Text="{Binding GroupName, StringFormat='in {0}'}" Style="{StaticResource MutedText}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End">
                                        <Label Text="{Binding Amount, StringFormat='{0:F2}'}" Style="{StaticResource CardTitle}" HorizontalTextAlignment="End" />
                                        <Label Text="{Binding ExpenseDate, StringFormat='{0:dd MMM}'}" Style="{StaticResource MutedText}" HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</views:AnimatedContentPage>
