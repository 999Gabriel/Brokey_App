<?xml version="1.0" encoding="utf-8" ?>
<views:AnimatedContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Brokey_APP.Views"
             xmlns:vm="clr-namespace:Brokey_APP.ViewModels"
             x:Class="Brokey_APP.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BrokeyBackground}">

    <ScrollView>
        <VerticalStackLayout Spacing="18">
            <Border StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,34,34" />
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFFF" Offset="0" />
                        <GradientStop Color="#F1E8FF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid HeightRequest="310" Padding="22,28,22,18">
                    <!-- Soft background blobs -->
                    <Border BackgroundColor="{StaticResource Secondary}"
                            Stroke="Transparent"
                            StrokeShape="Ellipse"
                            WidthRequest="240"
                            HeightRequest="240"
                            Opacity="0.9"
                            TranslationX="-110"
                            TranslationY="-80"
                            HorizontalOptions="Start"
                            VerticalOptions="Start" />
                    <Border BackgroundColor="{StaticResource Primary}"
                            Stroke="Transparent"
                            StrokeShape="Ellipse"
                            WidthRequest="220"
                            HeightRequest="220"
                            Opacity="0.07"
                            TranslationX="120"
                            TranslationY="-70"
                            HorizontalOptions="End"
                            VerticalOptions="Start" />
                    <Border BackgroundColor="{StaticResource Primary}"
                            Stroke="Transparent"
                            StrokeShape="Ellipse"
                            WidthRequest="300"
                            HeightRequest="300"
                            Opacity="0.05"
                            TranslationX="150"
                            TranslationY="120"
                            HorizontalOptions="End"
                            VerticalOptions="End" />

                    <!-- Big wordmark (bottom-right) -->
                    <Label Text="Brokey"
                           Style="{StaticResource BrokeyWordmarkGhost}"
                           FontSize="66"
                           Margin="0,0,4,0" />

                    <!-- Corner sidekick (overlay, responsive width) -->
                    <Grid HorizontalOptions="End"
                          VerticalOptions="End"
                          Margin="0,0,-10,-6"
                          ZIndex="2">
                        <Image Source="brokey_mascot.png"
                               HeightRequest="180"
                               WidthRequest="180"
                               Aspect="AspectFit"
                               HorizontalOptions="End"
                               VerticalOptions="End"
                               TranslationX="34"
                               TranslationY="12" />

                        <Grid WidthRequest="245"
                              HorizontalOptions="End"
                              VerticalOptions="End"
                              Margin="0,0,122,78">
                            <Border BackgroundColor="{StaticResource White}"
                                    Stroke="{StaticResource BorderSubtle}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="14,12">
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource BlackBrush}" Offset="0,10" Radius="22" Opacity="0.08" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="7">
                                    <Label Text="BROKEY"
                                           Style="{StaticResource MonoTag}" />
                                    <Label Style="{StaticResource SpeechBubbleText}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Meld dich an, dann " />
                                                <Span Text="splitten"
                                                      FontFamily="InterBold"
                                                      TextColor="{StaticResource Primary}" />
                                                <Span Text=" wir deine " />
                                                <Span Text="Ausgaben"
                                                      FontFamily="InterBold" />
                                                <Span Text=" sauber." />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="Ich bin gleich rechts."
                                           FontFamily="InterItalic"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Bubble tail -->
                            <Border BackgroundColor="{StaticResource White}"
                                    Stroke="{StaticResource BorderSubtle}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 3"
                                    WidthRequest="14"
                                    HeightRequest="14"
                                    Rotation="45"
                                    HorizontalOptions="End"
                                    VerticalOptions="End"
                                    TranslationX="-18"
                                    TranslationY="8" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <VerticalStackLayout Padding="22,0,22,26" Spacing="12">
                <Border StyleClass="SurfaceCard">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Sign in" Style="{StaticResource CardTitle}" />
                        <Label Text="{Binding ErrorMessage}"
                               IsVisible="{Binding HasError}"
                               Style="{StaticResource InlineErrorText}" />

                        <Border StyleClass="SurfaceCardMuted">
                            <Entry Placeholder="Email"
                                   Text="{Binding Email}"
                                   Keyboard="Email"
                                   ReturnType="Next" />
                        </Border>

                        <Border StyleClass="SurfaceCardMuted">
                            <Entry Placeholder="Password"
                                   Text="{Binding Password}"
                                   IsPassword="True"
                                   ReturnType="Done" />
                        </Border>

                        <Button Text="Forgot password?"
                                Style="{StaticResource LinkButton}"
                                Command="{Binding ForgotPasswordCommand}"
                                HorizontalOptions="End"
                                Margin="0,-2,0,0" />

                        <Button Text="Login"
                                Command="{Binding LoginCommand}" />

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="0">
                            <Label Text="New here?"
                                   VerticalOptions="Center"
                                   Style="{StaticResource MutedText}" />
                            <Button Text="Create account"
                                    Style="{StaticResource LinkButton}"
                                    Command="{Binding GoToRegisterCommand}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   HorizontalOptions="Center" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</views:AnimatedContentPage>
