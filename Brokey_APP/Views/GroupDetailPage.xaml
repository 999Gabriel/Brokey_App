<?xml version="1.0" encoding="utf-8" ?>
<views:AnimatedContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Brokey_APP.Views"
             xmlns:models="clr-namespace:Brokey_APP.Models"
             xmlns:vm="clr-namespace:Brokey_APP.ViewModels"
             x:Class="Brokey_APP.Views.GroupDetailPage"
             x:Name="GroupDetailPageRoot"
             x:DataType="vm:GroupDetailViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BrokeyBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="22,18,22,20" Spacing="12">

            <!-- Header -->
            <Label Text="{Binding GroupName}" Style="{StaticResource PageTitle}" />

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   Style="{StaticResource InlineErrorText}" />

            <!-- Action buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="Add member"
                        Command="{Binding OpenAddMemberCommand}"
                        FontFamily="InterSemiBold"
                        FontSize="14"/>
                <Button Grid.Column="1"
                        Text="Add expense"
                        Command="{Binding OpenAddExpenseCommand}"
                        FontFamily="InterSemiBold"
                        FontSize="14"/>
            </Grid>

            <!-- ── Settlement ── -->
            <Border BackgroundColor="{StaticResource White}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 18"
                    Padding="18,16">
                <VerticalStackLayout Spacing="14">

                        <Label Text="Settlement"
                               Style="{StaticResource SectionTitle}"
                               FontSize="17" />

                    <!-- Settled up -->
                    <HorizontalStackLayout Spacing="8"
                                           IsVisible="{Binding IsSettlementEmpty}">
                        <Label Text="OK"
                               FontSize="16"
                               TextColor="{StaticResource Success}"
                               VerticalOptions="Center"/>
                        <Label Text="Everyone is settled up!"
                               FontFamily="Inter"
                               FontSize="14"
                               TextColor="{StaticResource Gray500}"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- Who needs to pay whom -->
                    <VerticalStackLayout Spacing="0"
                                         IsVisible="{Binding HasSettlementTransfers}">
                        <Label Text="Payments needed"
                               FontFamily="InterSemiBold"
                               FontSize="12"
                               TextColor="{StaticResource Gray400}"
                               Margin="0,0,0,8"
                               CharacterSpacing="0.5"/>

                        <CollectionView ItemsSource="{Binding SettlementTransfers}"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:SettlementTransferResponse">
                                    <Border BackgroundColor="{StaticResource SurfaceSubtle}"
                                            Stroke="{StaticResource BorderSubtle}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="14,11"
                                            Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="6">
                                            <Label Grid.Column="0"
                                                   Text="{Binding FromUsername}"
                                                   FontFamily="InterSemiBold"
                                                   FontSize="13"
                                                   TextColor="{StaticResource BrokeyDarkBlue}"
                                                   VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation"/>
                                            <Label Grid.Column="1"
                                                   Text="→"
                                                   FontSize="14"
                                                   TextColor="{StaticResource Primary}"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"/>
                                            <Label Grid.Column="2"
                                                   Text="{Binding ToUsername}"
                                                   FontFamily="InterSemiBold"
                                                   FontSize="13"
                                                   TextColor="{StaticResource BrokeyDarkBlue}"
                                                   VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation"/>
                                            <Label Grid.Column="3"
                                                   Text="{Binding Amount, StringFormat='{0:F2}'}"
                                                   FontFamily="Charter"
                                                   FontSize="14"
                                                   TextColor="{StaticResource BrokeyOrange}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Balances -->
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Balances"
                               FontFamily="InterSemiBold"
                               FontSize="12"
                               TextColor="{StaticResource Gray400}"
                               Margin="0,0,0,8"
                               CharacterSpacing="0.5"/>

                        <CollectionView ItemsSource="{Binding SettlementBalances}"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:SettlementBalanceResponse">
                                    <Border BackgroundColor="{StaticResource BrokeyBackground}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="14,11"
                                            Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <!-- Avatar circle -->
                                            <Border BackgroundColor="{StaticResource Secondary}"
                                                    Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 20"
                                                    WidthRequest="38"
                                                    HeightRequest="38">
                                                <Label Text="{Binding Username}"
                                                       FontFamily="Charter"
                                                       FontSize="14"
                                                       TextColor="{StaticResource BrokeyDarkBlue}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       MaxLines="1"
                                                       LineBreakMode="TailTruncation"/>
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Username}"
                                                       FontFamily="InterSemiBold"
                                                       FontSize="14"
                                                       TextColor="{StaticResource BrokeyDarkBlue}"
                                                       LineBreakMode="TailTruncation"/>
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label Text="{Binding TotalPaid, StringFormat='paid {0:F2}'}"
                                                           FontFamily="Inter"
                                                           FontSize="11"
                                                           TextColor="{StaticResource Gray500}"/>
                                                    <Label Text="·"
                                                           FontFamily="Inter"
                                                           FontSize="11"
                                                           TextColor="{StaticResource Gray400}"/>
                                                    <Label Text="{Binding TotalShare, StringFormat='share {0:F2}'}"
                                                           FontFamily="Inter"
                                                           FontSize="11"
                                                           TextColor="{StaticResource Gray500}"/>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <Label Grid.Column="2"
                                                   Text="{Binding NetBalance, StringFormat='{0:+0.00;-0.00;0.00}'}"
                                                   FontFamily="Charter"
                                                   FontSize="16"
                                                   TextColor="{StaticResource BrokeyDarkBlue}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- ── Expenses ── -->
            <HorizontalStackLayout Spacing="8">
                <Label Text="Expenses"
                       Style="{StaticResource SectionTitle}"
                       FontSize="17"
                       VerticalOptions="Center"/>
                <Border BackgroundColor="{StaticResource BrokeyOrange}"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 10"
                        Padding="7,2"
                        IsVisible="{Binding HasExpenses}"
                        VerticalOptions="Center">
                    <Label Text="{Binding ExpensesCount}"
                           FontFamily="InterSemiBold"
                           FontSize="11"
                           TextColor="White"/>
                </Border>
            </HorizontalStackLayout>

            <Label Text="No expenses yet. Add one above!"
                   IsVisible="{Binding IsExpensesEmpty}"
                   FontFamily="Inter"
                   FontSize="14"
                   TextColor="{StaticResource Gray400}"
                   HorizontalOptions="Center"
                   Margin="0,4,0,0"/>

            <CollectionView ItemsSource="{Binding Expenses}"
                            IsVisible="{Binding HasExpenses}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ExpenseResponse">
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 16"
                                Padding="16,14"
                                Margin="0,0,0,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.OpenExpenseDetailCommand, Source={x:Reference GroupDetailPageRoot}}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="8">
                                <!-- Title + Amount -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Title}"
                                           FontFamily="InterSemiBold"
                                           FontSize="15"
                                           TextColor="{StaticResource BrokeyDarkBlue}"
                                           VerticalOptions="Center"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding Amount, StringFormat='{0:F2}'}"
                                           FontFamily="Charter"
                                           FontSize="17"
                                           TextColor="{StaticResource BrokeyDarkBlue}"
                                           VerticalOptions="Center"/>
                                </Grid>

                                <!-- Category badge + paid by -->
                                <HorizontalStackLayout Spacing="8">
                                    <Border BackgroundColor="{StaticResource Secondary}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="8,3">
                                        <Label Text="{Binding CategoryName}"
                                               FontFamily="InterSemiBold"
                                               FontSize="11"
                                               TextColor="{StaticResource BrokeyDarkBlue}"/>
                                    </Border>
                                    <Label Text="·"
                                           TextColor="{StaticResource Gray400}"
                                           FontSize="13"
                                           VerticalOptions="Center"/>
                                    <Label Text="{Binding PaidByUsername, StringFormat='paid by {0}'}"
                                           FontFamily="Inter"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <!-- Date + location indicator -->
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding ExpenseDate, StringFormat='{0:dd MMM yyyy}'}"
                                           FontFamily="Inter"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray400}"/>
                                    <Border BackgroundColor="#EAF7EE"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="6,2"
                                            IsVisible="{Binding HasLocation}">
                                        <Label Text="Location tagged"
                                               FontFamily="Inter"
                                               FontSize="10"
                                               TextColor="{StaticResource Success}"/>
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- ── Members ── -->
            <Label Text="Members"
                   Style="{StaticResource SectionTitle}"
                   FontSize="17"
                   Margin="0,4,0,0"/>

            <CollectionView ItemsSource="{Binding Members}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:GroupMemberResponse">
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 16"
                                Padding="16,14"
                                Margin="0,0,0,10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <!-- Avatar -->
                                <Border BackgroundColor="{StaticResource Secondary}"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 22"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Username}"
                                           FontFamily="Charter"
                                           FontSize="16"
                                           TextColor="{StaticResource BrokeyDarkBlue}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           MaxLines="1"
                                           LineBreakMode="TailTruncation"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Username}"
                                           FontFamily="InterSemiBold"
                                           FontSize="14"
                                           TextColor="{StaticResource BrokeyDarkBlue}"/>
                                    <Label Text="{Binding Email}"
                                           FontFamily="Inter"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}"
                                           LineBreakMode="TailTruncation"/>
                                    <Border BackgroundColor="{StaticResource Secondary}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="6,2"
                                            HorizontalOptions="Start">
                                        <Label Text="{Binding Role}"
                                               FontFamily="InterSemiBold"
                                               FontSize="10"
                                               TextColor="{StaticResource BrokeyDarkBlue}"/>
                                    </Border>
                                </VerticalStackLayout>

                                <Button Grid.Column="2"
                                        Text="Remove"
                                        VerticalOptions="Center"
                                        BackgroundColor="#FDECEC"
                                        TextColor="{StaticResource Danger}"
                                        FontFamily="InterSemiBold"
                                        FontSize="13"
                                        CornerRadius="10"
                                        Padding="12,8"
                                        Command="{Binding BindingContext.RemoveMemberCommand, Source={x:Reference GroupDetailPageRoot}}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="20" Color="Transparent"/>

        </VerticalStackLayout>
    </ScrollView>
</views:AnimatedContentPage>
