<?xml version="1.0" encoding="utf-8" ?>
<views:AnimatedContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Brokey_APP.Views"
             xmlns:models="clr-namespace:Brokey_APP.Models"
             xmlns:vm="clr-namespace:Brokey_APP.ViewModels"
             x:Class="Brokey_APP.Views.TripsPage"
             x:Name="TripsPageRoot"
             x:DataType="vm:TripsViewModel"
             Title="My Trips"
             BackgroundColor="{StaticResource BrokeyBackground}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="22,18,22,18">

        <!-- Header: title + create button -->
        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
            <VerticalStackLayout Spacing="2">
                <Label Text="Your trips" Style="{StaticResource PageTitle}" />
                <Label Text="All shared journeys in one place." Style="{StaticResource PageSubtitle}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="+"
                    Command="{Binding OpenCreateTripCommand}"
                    FontFamily="Inter"
                    FontSize="24"
                    WidthRequest="48"
                    HeightRequest="48"
                    CornerRadius="16"
                    Padding="0"
                    VerticalOptions="End" />
        </Grid>

        <Label Grid.Row="1"
               Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}"
               Style="{StaticResource InlineErrorText}"
               Margin="0,10,0,0" />

        <!-- Trips list -->
        <CollectionView Grid.Row="2"
                        Margin="0,14,0,0"
                        ItemsSource="{Binding Trips}"
                        IsVisible="{Binding HasTrips}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TripSummaryResponse">
                    <Border StyleClass="SurfaceCard">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding BindingContext.OpenTripCommand, Source={x:Reference TripsPageRoot}}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">

                            <!-- Row 0: Name + currency badge -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Name}"
                                       Style="{StaticResource CardTitle}"
                                       FontSize="17"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" />
                                <Border Grid.Column="1" StyleClass="TagPill">
                                    <Label Text="{Binding BaseCurrency}" Style="{StaticResource MonoTag}" />
                                </Border>
                            </Grid>

                            <!-- Row 1: Date range -->
                            <HorizontalStackLayout Grid.Row="1" Spacing="4">
                                <Label Text="{Binding StartDate, StringFormat='{0:dd MMM yyyy}'}"
                                       Style="{StaticResource MutedText}" />
                                <Label Text="–" Style="{StaticResource MutedText}" />
                                <Label Text="{Binding EndDate, StringFormat='{0:dd MMM yyyy}'}"
                                       Style="{StaticResource MutedText}" />
                            </HorizontalStackLayout>

                            <!-- Row 2: Stats + arrow -->
                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                <HorizontalStackLayout Spacing="6">
                                    <Border BackgroundColor="{StaticResource SurfaceSubtle}"
                                            Stroke="{StaticResource BorderSubtle}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="8,4">
                                        <Label Text="{Binding GroupCount, StringFormat='{0} groups'}"
                                               Style="{StaticResource MutedText}" />
                                    </Border>
                                    <Border BackgroundColor="{StaticResource SurfaceSubtle}"
                                            Stroke="{StaticResource BorderSubtle}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="8,4">
                                        <Label Text="{Binding MemberCount, StringFormat='{0} members'}"
                                               Style="{StaticResource MutedText}" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Grid.Column="1"
                                       Text="›"
                                       FontSize="22"
                                       TextColor="{StaticResource Gray400}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Empty state -->
        <VerticalStackLayout Grid.Row="2"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="12"
                             IsVisible="{Binding IsEmpty}">
            <Border StyleClass="TagPill" HorizontalOptions="Center">
                <Label Text="EMPTY" Style="{StaticResource MonoTag}" />
            </Border>
            <Label Text="{Binding EmptyMessage}"
                   Style="{StaticResource PageSubtitle}"
                   HorizontalTextAlignment="Center"
                   Margin="16,0" />
        </VerticalStackLayout>

    </Grid>
</views:AnimatedContentPage>
