<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Brokey_APP.ViewModels"
             x:Class="Brokey_APP.Views.AboutPage"
             x:DataType="vm:AboutViewModel"
             Title="About"
             BackgroundColor="{StaticResource BrokeyBackground}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ── Gradient Hero Banner ── -->
            <Border StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,36,36"/>
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1B3A5C" Offset="0"/>
                        <GradientStop Color="#5BA3C9" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="12"
                                     Padding="24,52,24,36">

                    <!-- Mascot with glow circle -->
                    <Border BackgroundColor="#FFFFFF18"
                            StrokeShape="Ellipse"
                            Stroke="Transparent"
                            WidthRequest="110"
                            HeightRequest="110"
                            HorizontalOptions="Center">
                        <Image Source="brokey_mascot.png"
                               HeightRequest="72"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <!-- App name + version pill -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <Label Text="Brokey"
                               FontFamily="Pacifico"
                               FontSize="34"
                               TextColor="White"
                               VerticalOptions="Center"/>
                        <Border BackgroundColor="#FFFFFF25"
                                StrokeShape="RoundRectangle 20"
                                Stroke="#FFFFFF50"
                                StrokeThickness="1"
                                Padding="10,5"
                                VerticalOptions="Center">
                            <Label Text="{Binding Version, StringFormat='v{0}'}"
                                   FontFamily="PoppinsSemiBold"
                                   FontSize="12"
                                   TextColor="White"/>
                        </Border>
                    </HorizontalStackLayout>

                    <Label Text="Split smarter, travel better."
                           FontFamily="PoppinsRegular"
                           FontSize="14"
                           TextColor="#B0D4E8"
                           HorizontalOptions="Center"/>

                </VerticalStackLayout>
            </Border>

            <!-- ── Content ── -->
            <VerticalStackLayout Padding="20,24,20,0" Spacing="16">

                <!-- What is Brokey card -->
                <Border BackgroundColor="{StaticResource White}"
                        StrokeShape="RoundRectangle 20"
                        Stroke="Transparent">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Gray300Brush}" Offset="0,4" Radius="16" Opacity="0.07"/>
                    </Border.Shadow>
                    <VerticalStackLayout Padding="20" Spacing="10">
                        <Label Text="What is Brokey?"
                               FontFamily="PoppinsSemiBold"
                               FontSize="17"
                               TextColor="{StaticResource BrokeyDarkBlue}"/>
                        <Label Text="{Binding AppDescription}"
                               FontFamily="PoppinsRegular"
                               FontSize="14"
                               TextColor="{StaticResource Gray500}"
                               LineHeight="1.6"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Features card -->
                <Border BackgroundColor="{StaticResource White}"
                        StrokeShape="RoundRectangle 20"
                        Stroke="Transparent">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Gray300Brush}" Offset="0,4" Radius="16" Opacity="0.07"/>
                    </Border.Shadow>
                    <VerticalStackLayout Padding="20" Spacing="0">

                        <Label Text="Features"
                               FontFamily="PoppinsSemiBold"
                               FontSize="17"
                               TextColor="{StaticResource BrokeyDarkBlue}"
                               Margin="0,0,0,14"/>

                        <!-- Track expenses -->
                        <Grid ColumnDefinitions="46,*" Padding="0,10" ColumnSpacing="0">
                            <Border Grid.Column="0"
                                    BackgroundColor="#FFF0E6"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    WidthRequest="36" HeightRequest="36"
                                    HorizontalOptions="Start" VerticalOptions="Center">
                                <Label Text="💰" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1"
                                   Text="Track expenses on every trip"
                                   FontFamily="PoppinsRegular" FontSize="14"
                                   TextColor="{StaticResource Gray600}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="46,0,0,0"/>

                        <!-- Split costs -->
                        <Grid ColumnDefinitions="46,*" Padding="0,10" ColumnSpacing="0">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource Secondary}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    WidthRequest="36" HeightRequest="36"
                                    HorizontalOptions="Start" VerticalOptions="Center">
                                <Label Text="👥" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1"
                                   Text="Split costs fairly with friends"
                                   FontFamily="PoppinsRegular" FontSize="14"
                                   TextColor="{StaticResource Gray600}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="46,0,0,0"/>

                        <!-- Receipts -->
                        <Grid ColumnDefinitions="46,*" Padding="0,10" ColumnSpacing="0">
                            <Border Grid.Column="0"
                                    BackgroundColor="#F0EEFF"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    WidthRequest="36" HeightRequest="36"
                                    HorizontalOptions="Start" VerticalOptions="Center">
                                <Label Text="🧾" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1"
                                   Text="Upload receipts as proof"
                                   FontFamily="PoppinsRegular" FontSize="14"
                                   TextColor="{StaticResource Gray600}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="46,0,0,0"/>

                        <!-- Currency -->
                        <Grid ColumnDefinitions="46,*" Padding="0,10" ColumnSpacing="0">
                            <Border Grid.Column="0"
                                    BackgroundColor="#E8F8EE"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    WidthRequest="36" HeightRequest="36"
                                    HorizontalOptions="Start" VerticalOptions="Center">
                                <Label Text="💱" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1"
                                   Text="Automatic currency conversion"
                                   FontFamily="PoppinsRegular" FontSize="14"
                                   TextColor="{StaticResource Gray600}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="46,0,0,0"/>

                        <!-- Map -->
                        <Grid ColumnDefinitions="46,*" Padding="0,10" ColumnSpacing="0">
                            <Border Grid.Column="0"
                                    BackgroundColor="#FEF0F0"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    WidthRequest="36" HeightRequest="36"
                                    HorizontalOptions="Start" VerticalOptions="Center">
                                <Label Text="📍" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1"
                                   Text="Pin expenses on a map"
                                   FontFamily="PoppinsRegular" FontSize="14"
                                   TextColor="{StaticResource Gray600}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="46,0,0,0"/>

                        <!-- Guided -->
                        <Grid ColumnDefinitions="46,*" Padding="0,10" ColumnSpacing="0">
                            <Border Grid.Column="0"
                                    BackgroundColor="#FFF0E6"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    WidthRequest="36" HeightRequest="36"
                                    HorizontalOptions="Start" VerticalOptions="Center">
                                <Label Text="🧳" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1"
                                   Text="Brokey guides you through it all"
                                   FontFamily="PoppinsRegular" FontSize="14"
                                   TextColor="{StaticResource Gray600}"
                                   VerticalOptions="Center"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Impressum -->
                <Button Text="Impressum"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Gray400}"
                        FontFamily="PoppinsRegular"
                        FontSize="13"
                        Command="{Binding OpenImpressumCommand}"
                        HorizontalOptions="Center"
                        Margin="0,4,0,36"/>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
