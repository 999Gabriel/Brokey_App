<?xml version="1.0" encoding="utf-8" ?>
<views:AnimatedContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Brokey_APP.Views"
             xmlns:vm="clr-namespace:Brokey_APP.ViewModels"
             x:Class="Brokey_APP.Views.AboutPage"
             x:DataType="vm:AboutViewModel"
             Title="About"
             BackgroundColor="{StaticResource BrokeyBackground}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ── Gradient Hero Banner ── -->
            <Border StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,36,36"/>
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#F1E8FF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="12"
                                     Padding="24,52,24,36">

                    <Border BackgroundColor="#F4EEFF"
                            StrokeShape="Ellipse"
                            Stroke="{StaticResource Primary}"
                            StrokeThickness="1"
                            WidthRequest="130"
                            HeightRequest="130"
                            HorizontalOptions="Center">
                        <Image Source="brokey_mascot.png"
                               HeightRequest="90"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <!-- App name + version pill -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <Label Text="Brokey"
                               FontFamily="Charter"
                               FontSize="32"
                               CharacterSpacing="1"
                               TextColor="{StaticResource BrokeyDarkBlue}"
                               VerticalOptions="Center"/>
                        <Border BackgroundColor="{StaticResource White}"
                                StrokeShape="RoundRectangle 20"
                                Stroke="{StaticResource BorderSubtle}"
                                StrokeThickness="1"
                                Padding="10,5"
                                VerticalOptions="Center">
                            <Label Text="{Binding Version, StringFormat='v{0}'}"
                                   FontFamily="InterSemiBold"
                                   FontSize="12"
                                   TextColor="{StaticResource Primary}"/>
                        </Border>
                    </HorizontalStackLayout>

                    <Label Text="Split smarter, travel better."
                           FontFamily="Inter"
                           FontSize="14"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center"/>

                </VerticalStackLayout>
            </Border>

            <!-- ── Content ── -->
            <VerticalStackLayout Padding="20,24,20,0" Spacing="16">

                <!-- What is Brokey card -->
                <Border BackgroundColor="{StaticResource Surface}"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{StaticResource BorderSubtle}"
                        StrokeThickness="1">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource BlackBrush}" Offset="0,4" Radius="16" Opacity="0.2"/>
                    </Border.Shadow>
                    <VerticalStackLayout Padding="20" Spacing="10">
                        <Label Text="What is Brokey?"
                               FontFamily="InterSemiBold"
                               FontSize="17"
                               TextColor="{StaticResource BrokeyDarkBlue}"/>
                        <Label Text="{Binding AppDescription}"
                               FontFamily="Inter"
                               FontSize="14"
                               TextColor="{StaticResource Gray500}"
                               LineHeight="1.6"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Features card -->
                <Border BackgroundColor="{StaticResource Surface}"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{StaticResource BorderSubtle}"
                        StrokeThickness="1">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource BlackBrush}" Offset="0,4" Radius="16" Opacity="0.2"/>
                    </Border.Shadow>
                    <VerticalStackLayout Padding="20" Spacing="0">

                        <Label Text="Features"
                               FontFamily="InterSemiBold"
                               FontSize="17"
                               TextColor="{StaticResource BrokeyDarkBlue}"
                               Margin="0,0,0,14"/>

                        <!-- Track expenses -->
                        <Grid ColumnDefinitions="46,*" Padding="0,10" ColumnSpacing="0">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource SurfaceSubtle}"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    WidthRequest="36" HeightRequest="36"
                                    HorizontalOptions="Start" VerticalOptions="Center">
                                <Label Text="EXP"
                                       FontFamily="Charter"
                                       FontSize="11"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1"
                                   Text="Track expenses on every trip"
                                   FontFamily="Inter" FontSize="14"
                                   TextColor="{StaticResource Gray600}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="46,0,0,0"/>

                        <!-- Split costs -->
                        <Grid ColumnDefinitions="46,*" Padding="0,10" ColumnSpacing="0">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource Secondary}"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    WidthRequest="36" HeightRequest="36"
                                    HorizontalOptions="Start" VerticalOptions="Center">
                                <Label Text="SPL"
                                       FontFamily="Charter"
                                       FontSize="11"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1"
                                   Text="Split costs fairly with friends"
                                   FontFamily="Inter" FontSize="14"
                                   TextColor="{StaticResource Gray600}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="46,0,0,0"/>

                        <!-- Receipts -->
                        <Grid ColumnDefinitions="46,*" Padding="0,10" ColumnSpacing="0">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource Secondary}"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    WidthRequest="36" HeightRequest="36"
                                    HorizontalOptions="Start" VerticalOptions="Center">
                                <Label Text="RCP"
                                       FontFamily="Charter"
                                       FontSize="11"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1"
                                   Text="Upload receipts as proof"
                                   FontFamily="Inter" FontSize="14"
                                   TextColor="{StaticResource Gray600}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="46,0,0,0"/>

                        <!-- Currency -->
                        <Grid ColumnDefinitions="46,*" Padding="0,10" ColumnSpacing="0">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource SurfaceSubtle}"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    WidthRequest="36" HeightRequest="36"
                                    HorizontalOptions="Start" VerticalOptions="Center">
                                <Label Text="FX"
                                       FontFamily="Charter"
                                       FontSize="11"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1"
                                   Text="Automatic currency conversion"
                                   FontFamily="Inter" FontSize="14"
                                   TextColor="{StaticResource Gray600}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="46,0,0,0"/>

                        <!-- Map -->
                        <Grid ColumnDefinitions="46,*" Padding="0,10" ColumnSpacing="0">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource SurfaceSubtle}"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    WidthRequest="36" HeightRequest="36"
                                    HorizontalOptions="Start" VerticalOptions="Center">
                                <Label Text="MAP"
                                       FontFamily="Charter"
                                       FontSize="10"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1"
                                   Text="Pin expenses on a map"
                                   FontFamily="Inter" FontSize="14"
                                   TextColor="{StaticResource Gray600}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="46,0,0,0"/>

                        <!-- Guided -->
                        <Grid ColumnDefinitions="46,*" Padding="0,10" ColumnSpacing="0">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource Secondary}"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    WidthRequest="36" HeightRequest="36"
                                    HorizontalOptions="Start" VerticalOptions="Center">
                                <Label Text="GUIDE"
                                       FontFamily="Charter"
                                       FontSize="9"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1"
                                   Text="Brokey guides you through it all"
                                   FontFamily="Inter" FontSize="14"
                                   TextColor="{StaticResource Gray600}"
                                   VerticalOptions="Center"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Impressum -->
                <Button Text="Impressum"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Gray400}"
                        FontFamily="Inter"
                        FontSize="13"
                        Command="{Binding OpenImpressumCommand}"
                        HorizontalOptions="Center"
                        Margin="0,4,0,36"/>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</views:AnimatedContentPage>
