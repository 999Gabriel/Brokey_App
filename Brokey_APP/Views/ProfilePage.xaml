<?xml version="1.0" encoding="utf-8" ?>
<views:AnimatedContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Brokey_APP.Views"
             xmlns:vm="clr-namespace:Brokey_APP.ViewModels"
             x:Class="Brokey_APP.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Profile"
             BackgroundColor="{StaticResource BrokeyBackground}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ── Gradient Hero Header ── -->
            <Border StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,36,36"/>
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#F1E8FF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="10"
                                     Padding="24,52,24,36">

                    <!-- Avatar -->
                    <Border StrokeShape="Ellipse"
                            Stroke="{StaticResource Primary}"
                            StrokeThickness="2"
                            BackgroundColor="{StaticResource White}"
                            WidthRequest="110"
                            HeightRequest="110"
                            HorizontalOptions="Center">
                        <Image Source="brokey_mascot.png"
                               HeightRequest="72"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <Label Text="{Binding Username}"
                           FontFamily="Charter"
                           FontSize="24"
                           TextColor="{StaticResource BrokeyDarkBlue}"
                           HorizontalOptions="Center"/>

                    <Label Text="{Binding Email}"
                           FontFamily="Inter"
                           FontSize="13"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center"/>

                    <!-- Currency pill -->
                    <Border BackgroundColor="{StaticResource White}"
                            StrokeShape="RoundRectangle 20"
                            Stroke="{StaticResource BorderSubtle}"
                            StrokeThickness="1"
                            Padding="14,6"
                            HorizontalOptions="Center"
                            Margin="0,6,0,0">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="CUR"
                                   FontFamily="InterSemiBold"
                                   FontSize="11"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center"/>
                            <Label Text="{Binding BaseCurrency}"
                                   FontFamily="InterSemiBold"
                                   FontSize="13"
                                   TextColor="{StaticResource BrokeyDarkBlue}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- ── Settings Rows ── -->
            <VerticalStackLayout Padding="20,24,20,0" Spacing="12">

                <Border BackgroundColor="{StaticResource Surface}"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{StaticResource BorderSubtle}"
                        StrokeThickness="1">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource BlackBrush}" Offset="0,4" Radius="16" Opacity="0.2"/>
                    </Border.Shadow>
                    <VerticalStackLayout Padding="4">

                        <!-- My Groups -->
                        <Grid ColumnDefinitions="52,*,Auto"
                              Padding="14,14" ColumnSpacing="0">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource Secondary}"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    WidthRequest="38" HeightRequest="38"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                <Label Text="GR"
                                       FontFamily="Charter"
                                       FontSize="12"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Margin="4,0,0,0" VerticalOptions="Center">
                                <Label Text="My Groups"
                                       FontFamily="InterSemiBold"
                                       FontSize="15"
                                       TextColor="{StaticResource BrokeyDarkBlue}"/>
                                <Label Text="Manage your travel groups"
                                       FontFamily="Inter"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray400}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›"
                                   FontSize="24"
                                   TextColor="{StaticResource Gray300}"
                                   VerticalOptions="Center"
                                   Margin="0,0,4,0"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="66,0,16,0"/>

                        <!-- Settings -->
                        <Grid ColumnDefinitions="52,*,Auto"
                              Padding="14,14" ColumnSpacing="0">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource SurfaceSubtle}"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    WidthRequest="38" HeightRequest="38"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                <Label Text="APP"
                                       FontFamily="Charter"
                                       FontSize="11"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Margin="4,0,0,0" VerticalOptions="Center">
                                <Label Text="Settings"
                                       FontFamily="InterSemiBold"
                                       FontSize="15"
                                       TextColor="{StaticResource BrokeyDarkBlue}"/>
                                <Label Text="App preferences"
                                       FontFamily="Inter"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray400}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›"
                                   FontSize="24"
                                   TextColor="{StaticResource Gray300}"
                                   VerticalOptions="Center"
                                   Margin="0,0,4,0"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Logout Button -->
                <Border BackgroundColor="#FDECEC"
                        StrokeShape="RoundRectangle 16"
                        Stroke="#F7CACA"
                        StrokeThickness="1"
                        Margin="0,8,0,36">
                    <Button Text="Log Out"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Danger}"
                            FontFamily="InterSemiBold"
                            FontSize="16"
                            Command="{Binding LogoutCommand}"
                            HeightRequest="54"/>
                </Border>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</views:AnimatedContentPage>
