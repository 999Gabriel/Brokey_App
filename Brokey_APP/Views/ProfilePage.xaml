<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Brokey_APP.ViewModels"
             x:Class="Brokey_APP.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Profile"
             BackgroundColor="{StaticResource BrokeyBackground}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ── Gradient Hero Header ── -->
            <Border StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,36,36"/>
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1B3A5C" Offset="0"/>
                        <GradientStop Color="#5BA3C9" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="10"
                                     Padding="24,52,24,36">

                    <!-- Avatar with white ring -->
                    <Border StrokeShape="Ellipse"
                            Stroke="White"
                            StrokeThickness="3"
                            BackgroundColor="{StaticResource Secondary}"
                            WidthRequest="90"
                            HeightRequest="90"
                            HorizontalOptions="Center">
                        <Image Source="brokey_mascot.png"
                               HeightRequest="58"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <Label Text="{Binding Username}"
                           FontFamily="PoppinsBold"
                           FontSize="22"
                           TextColor="White"
                           HorizontalOptions="Center"/>

                    <Label Text="{Binding Email}"
                           FontFamily="PoppinsRegular"
                           FontSize="13"
                           TextColor="#B0D4E8"
                           HorizontalOptions="Center"/>

                    <!-- Currency pill -->
                    <Border BackgroundColor="#FFFFFF22"
                            StrokeShape="RoundRectangle 20"
                            Stroke="#FFFFFF40"
                            StrokeThickness="1"
                            Padding="14,6"
                            HorizontalOptions="Center"
                            Margin="0,6,0,0">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="💱" FontSize="13" VerticalOptions="Center"/>
                            <Label Text="{Binding BaseCurrency}"
                                   FontFamily="PoppinsSemiBold"
                                   FontSize="13"
                                   TextColor="White"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- ── Settings Rows ── -->
            <VerticalStackLayout Padding="20,24,20,0" Spacing="12">

                <Border BackgroundColor="{StaticResource White}"
                        StrokeShape="RoundRectangle 20"
                        Stroke="Transparent">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Gray300Brush}" Offset="0,4" Radius="16" Opacity="0.07"/>
                    </Border.Shadow>
                    <VerticalStackLayout Padding="4">

                        <!-- My Groups -->
                        <Grid ColumnDefinitions="52,*,Auto"
                              Padding="14,14" ColumnSpacing="0">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource Secondary}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    WidthRequest="38" HeightRequest="38"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                <Label Text="👥" FontSize="18"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Margin="4,0,0,0" VerticalOptions="Center">
                                <Label Text="My Groups"
                                       FontFamily="PoppinsSemiBold"
                                       FontSize="15"
                                       TextColor="{StaticResource BrokeyDarkBlue}"/>
                                <Label Text="Manage your travel groups"
                                       FontFamily="PoppinsRegular"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray400}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›"
                                   FontSize="24"
                                   TextColor="{StaticResource Gray300}"
                                   VerticalOptions="Center"
                                   Margin="0,0,4,0"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="66,0,16,0"/>

                        <!-- Settings -->
                        <Grid ColumnDefinitions="52,*,Auto"
                              Padding="14,14" ColumnSpacing="0">
                            <Border Grid.Column="0"
                                    BackgroundColor="#FFF0E6"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    WidthRequest="38" HeightRequest="38"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                <Label Text="⚙️" FontSize="18"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Margin="4,0,0,0" VerticalOptions="Center">
                                <Label Text="Settings"
                                       FontFamily="PoppinsSemiBold"
                                       FontSize="15"
                                       TextColor="{StaticResource BrokeyDarkBlue}"/>
                                <Label Text="App preferences"
                                       FontFamily="PoppinsRegular"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray400}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›"
                                   FontSize="24"
                                   TextColor="{StaticResource Gray300}"
                                   VerticalOptions="Center"
                                   Margin="0,0,4,0"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Logout Button -->
                <Border BackgroundColor="#FFF5F5"
                        StrokeShape="RoundRectangle 20"
                        Stroke="#FFD6D6"
                        StrokeThickness="1"
                        Margin="0,8,0,36">
                    <Button Text="Log Out"
                            BackgroundColor="Transparent"
                            TextColor="#E53935"
                            FontFamily="PoppinsSemiBold"
                            FontSize="16"
                            Command="{Binding LogoutCommand}"
                            HeightRequest="54"/>
                </Border>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
