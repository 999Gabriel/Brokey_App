<?xml version="1.0" encoding="utf-8" ?>
<views:AnimatedContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Brokey_APP.Views"
             xmlns:models="clr-namespace:Brokey_APP.Models"
             xmlns:vm="clr-namespace:Brokey_APP.ViewModels"
             x:Class="Brokey_APP.Views.TripDetailPage"
             x:Name="TripDetailPageRoot"
             x:DataType="vm:TripDetailViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BrokeyBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="22,18,22,20" Spacing="12">
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Name}" Style="{StaticResource PageTitle}" />
                    <Label Text="{Binding Description}" Style="{StaticResource PageSubtitle}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="Summary"
                        Command="{Binding OpenSummaryCommand}"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="12"
                        HeightRequest="36"
                        Padding="12,0"
                        VerticalOptions="Start" />
            </Grid>

            <Border StyleClass="SurfaceCard">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Trip summary" Style="{StaticResource SectionTitle}" FontSize="16" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Total expenses" Style="{StaticResource MutedText}" />
                            <Label Text="{Binding TotalExpenseAmount, StringFormat='{0:F2}'}" Style="{StaticResource CardTitle}" TextColor="{StaticResource BrokeyOrange}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Base currency" Style="{StaticResource MutedText}" />
                            <Label Text="{Binding BaseCurrency}" Style="{StaticResource CardTitle}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                            <Label Text="Members" Style="{StaticResource MutedText}" />
                            <Label Text="{Binding MemberCount}" Style="{StaticResource CardTitle}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                            <Label Text="Range" Style="{StaticResource MutedText}" />
                            <Label Text="{Binding StartDate, StringFormat='{0:dd MMM}'}"
                                   Style="{StaticResource CardTitle}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   Style="{StaticResource InlineErrorText}" />

            <Label Text="Trip members"
                   Style="{StaticResource SectionTitle}"
                   FontSize="18" />

            <Border StyleClass="SurfaceCard">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Members}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:TripMemberResponse">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border BackgroundColor="{StaticResource Secondary}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 15"
                                        WidthRequest="30"
                                        HeightRequest="30">
                                    <Label Text="{Binding Username}"
                                           FontSize="10"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource BrokeyDarkBlue}" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Username}" VerticalOptions="Center" />
                                <Border Grid.Column="2" StyleClass="TagPill" IsVisible="{Binding Role, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Owner'}">
                                    <Label Text="OWNER" Style="{StaticResource MonoTag}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Label Text="Groups"
                       Style="{StaticResource SectionTitle}"
                       FontSize="18"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Add group"
                        Command="{Binding CreateGroupCommand}"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="12"
                        HeightRequest="36"
                        Padding="12,0" />
            </Grid>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Groups}"
                                 Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:GroupResponse">
                        <Border StyleClass="SurfaceCard">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.OpenGroupCommand, Source={x:Reference TripDetailPageRoot}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                    <Label Text="{Binding MemberCount, StringFormat='{0} members'}"
                                           Style="{StaticResource MutedText}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="›"
                                       FontSize="22"
                                       TextColor="{StaticResource Gray400}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</views:AnimatedContentPage>
