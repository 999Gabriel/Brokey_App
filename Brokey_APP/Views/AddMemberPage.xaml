<?xml version="1.0" encoding="utf-8" ?>
<views:AnimatedContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Brokey_APP.Views"
             xmlns:vm="clr-namespace:Brokey_APP.ViewModels"
             x:Class="Brokey_APP.Views.AddMemberPage"
             x:DataType="vm:AddMemberViewModel"
             Title="Add Member"
             BackgroundColor="{StaticResource BrokeyBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="22,18,22,20" Spacing="20">

            <!-- Header -->
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding GroupName, StringFormat='Invite to {0}'}"
                       Style="{StaticResource PageTitle}" />
                <Label Text="Enter the username or email of the person you want to add."
                       Style="{StaticResource PageSubtitle}" />
            </VerticalStackLayout>

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   Style="{StaticResource InlineErrorText}" />

            <!-- Input card -->
            <Border StyleClass="SurfaceCard">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Username or email"
                           FontFamily="InterSemiBold"
                           FontSize="13"
                           TextColor="{StaticResource Gray600}" />
                    <Border StyleClass="SurfaceCardMuted">
                        <Entry Placeholder="e.g. john or john@email.com"
                               Text="{Binding UsernameOrEmail}"
                               Keyboard="Email"
                               ReturnType="Done"
                               ReturnCommand="{Binding AddMemberCommand}" />
                    </Border>
                    <Label Text="They'll be added as a member and can view and add expenses."
                           FontFamily="Inter"
                           FontSize="12"
                           TextColor="{StaticResource Gray400}" />
                </VerticalStackLayout>
            </Border>

            <!-- Actions -->
            <VerticalStackLayout Spacing="10">
                <Button Text="Add member"
                        Command="{Binding AddMemberCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                <Button Text="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButton}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</views:AnimatedContentPage>
